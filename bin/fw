#!/bin/sh
set -u

SELF_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd)
ROOT_DIR=$(CDPATH='' cd "$SELF_DIR/.." && pwd)
VERSION=$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf '%s' '0.0.0-unknown')
FW_REPO_BASE=${FW_REPO_BASE:-https://fritz-wulf.github.io/repo/}
FW_INDEX_URL=${FW_REPO_INDEX_URL:-${FW_REPO_BASE%/}/index.json}
FW_PACKAGES_URL=${FW_PACKAGES_URL:-${FW_REPO_BASE%/}/Packages}
FW_SUMS_URL=${FW_SUMS_URL:-${FW_REPO_BASE%/}/SHA256SUMS}
FW_CACHE_DIR=${FW_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/fritzwulf}
INDEX_CACHE=$FW_CACHE_DIR/index.json
PACKAGES_CACHE=$FW_CACHE_DIR/Packages
SUMS_CACHE=$FW_CACHE_DIR/SHA256SUMS
JSON=0
QUIET=0

log(){ [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
fail(){ code=$1; shift; printf 'fw: %s\n' "$*" >&2; exit "$code"; }
json_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g'; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --) shift; break ;;
    -*) fail 64 "unknown option: $1" ;;
    *) break ;;
  esac
done
fetch_url(){
  url=$1; dest=$2
  case "$url" in
    file://*) cp "${url#file://}" "$dest" || return 1 ;;
    *)
      if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 10 --retry 2 -o "$dest" "$url" || return 1
      elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$dest" "$url" || return 1
      else
        return 127
      fi
      ;;
  esac
}

atomic_fetch(){
  url=$1; dest=$2; target=$2
  mkdir -p "$FW_CACHE_DIR" || fail 73 "cannot create cache: $FW_CACHE_DIR"
  tmp=$(mktemp "$FW_CACHE_DIR/.fw.XXXXXX") || fail 73 "cannot create temporary file"
  if ! fetch_url "$url" "$tmp"; then rm -f "$tmp"; fail 69 "download failed: $url"; fi
  [ -s "$tmp" ] || { rm -f "$tmp"; fail 65 "empty download: $url"; }
  mv -f "$tmp" "$target" || { rm -f "$tmp"; fail 73 "cannot activate cache file"; }
}

ensure_feed(){ [ -s "$PACKAGES_CACHE" ] || fail 69 "package cache missing; run: fw update"; }
sha256_file(){
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v busybox >/dev/null 2>&1; then busybox sha256sum "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | awk '{print $NF}'
  else return 127
  fi
}

manifest_hash(){
  manifest=$1; wanted=$2
  awk -v f="$wanted" '$2==f {print $1; found=1; exit} END{if(!found) exit 1}' "$manifest"
}

verify_manifest_file(){
  manifest=$1; filename=$2; filepath=$3
  expected=$(manifest_hash "$manifest" "$filename") || fail 65 "repository manifest missing: $filename"
  printf '%s' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$' || fail 65 "invalid repository checksum: $filename"
  actual=$(sha256_file "$filepath") || fail 69 "no SHA-256 implementation available"
  [ "$(printf '%s' "$actual" | tr 'A-F' 'a-f')" = "$(printf '%s' "$expected" | tr 'A-F' 'a-f')" ] || fail 65 "repository checksum mismatch: $filename"
}

cmd_update(){
  mkdir -p "$FW_CACHE_DIR" || fail 73 "cannot create cache: $FW_CACHE_DIR"
  stage=$(mktemp -d "$FW_CACHE_DIR/.update.XXXXXX") || fail 73 "cannot create update staging directory"
  trap 'rm -rf "$stage"' 0 1 2 15
  fetch_url "$FW_SUMS_URL" "$stage/SHA256SUMS" || fail 69 "download failed: $FW_SUMS_URL"
  fetch_url "$FW_INDEX_URL" "$stage/index.json" || fail 69 "download failed: $FW_INDEX_URL"
  fetch_url "$FW_PACKAGES_URL" "$stage/Packages" || fail 69 "download failed: $FW_PACKAGES_URL"
  if [ ! -s "$stage/SHA256SUMS" ] || [ ! -s "$stage/index.json" ] || [ ! -s "$stage/Packages" ]; then
    fail 65 "empty repository metadata download"
  fi
  grep -q '"packages"' "$stage/index.json" || fail 65 "index.json does not contain packages"
  verify_manifest_file "$stage/SHA256SUMS" index.json "$stage/index.json"
  verify_manifest_file "$stage/SHA256SUMS" Packages "$stage/Packages"
  mv -f "$stage/index.json" "$INDEX_CACHE" || fail 73 "cannot activate index cache"
  mv -f "$stage/Packages" "$PACKAGES_CACHE" || fail 73 "cannot activate package cache"
  mv -f "$stage/SHA256SUMS" "$SUMS_CACHE" || fail 73 "cannot activate checksum manifest"
  rmdir "$stage"; trap - 0 1 2 15
  log "repository updated: $FW_INDEX_URL"
}
cmd_list(){
  ensure_feed
  awk 'BEGIN{RS="";FS="\n"} {p=v=a=i=""; for(n=1;n<=NF;n++){if($n~/^Package: /)p=substr($n,10); else if($n~/^Version: /)v=substr($n,10); else if($n~/^Architecture: /)a=substr($n,15); else if($n~/^(Installable|X-Fritz-Wulf-Installable): /){i=$n;sub(/^[^:]+: /,"",i)}} if(p!="") printf "%s\t%s\t%s\t%s\n",p,v,a,i}' "$PACKAGES_CACHE"
}

cmd_search(){
  ensure_feed
  [ "$#" -gt 0 ] || fail 64 "search requires a query"
  query=$1
  awk -v q="$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')" 'BEGIN{RS="";FS="\n"} tolower($0)~q {p=v=a=i=""; for(n=1;n<=NF;n++){if($n~/^Package: /)p=substr($n,10); else if($n~/^Version: /)v=substr($n,10); else if($n~/^Architecture: /)a=substr($n,15); else if($n~/^(Installable|X-Fritz-Wulf-Installable): /){i=$n;sub(/^[^:]+: /,"",i)}} if(p!="") printf "%s\t%s\t%s\t%s\n",p,v,a,i}' "$PACKAGES_CACHE"
}

cmd_info(){
  ensure_feed
  [ "$#" -gt 0 ] || fail 64 "info requires a package name"
  name=$1
  awk -v wanted="$name" 'BEGIN{RS=""} $0 ~ ("(^|\n)Package: " wanted "(\n|$)") {print; found=1; exit} END{if(!found) exit 1}' "$PACKAGES_CACHE" || fail 66 "package not found: $name"
}

cmd_verify(){
  ensure_feed
  [ "$#" -eq 2 ] || fail 64 "verify requires: <package> <version>"
  verify_name=$1; verify_version=$2
  verify_meta=$(mktemp "$FW_CACHE_DIR/.verify-meta.XXXXXX") || fail 73 "cannot create verification metadata"
  verify_tmp=$(mktemp "$FW_CACHE_DIR/.verify-artifact.XXXXXX") || { rm -f "$verify_meta"; fail 73 "cannot create verification file"; }
  trap 'rm -f "$verify_meta" "$verify_tmp"' 0 1 2 15
  awk -v p="$verify_name" -v v="$verify_version" 'BEGIN{RS="";FS="\n"} {pn=vn=""; for(n=1;n<=NF;n++){if($n~/^Package: /)pn=substr($n,10); else if($n~/^Version: /)vn=substr($n,10)} if(pn==p && vn==v){print; found=1; exit}} END{if(!found) exit 1}' "$PACKAGES_CACHE" > "$verify_meta" || fail 66 "package version not found: $verify_name $verify_version"
  verify_filename=$(sed -n 's/^Filename: //p' "$verify_meta" | head -1)
  verify_size=$(sed -n 's/^Size: //p' "$verify_meta" | head -1)
  verify_sha=$(sed -n 's/^SHA256sum: //p' "$verify_meta" | head -1)
  if [ -z "$verify_filename" ] || [ -z "$verify_size" ] || [ -z "$verify_sha" ]; then
    fail 65 "incomplete verification metadata"
  fi
  case "$verify_filename" in /*|*..*) fail 65 "unsafe package path: $verify_filename" ;; esac
  case "$verify_size" in ''|*[!0-9]*) fail 65 "invalid package size" ;; esac
  printf '%s' "$verify_sha" | grep -Eq '^[0-9a-fA-F]{64}$' || fail 65 "invalid package checksum"
  verify_url=${FW_REPO_BASE%/}/$verify_filename
  fetch_url "$verify_url" "$verify_tmp" || fail 69 "download failed: $verify_url"
  verify_actual_size=$(wc -c < "$verify_tmp" | tr -d '[:space:]')
  [ "$verify_actual_size" = "$verify_size" ] || fail 65 "size mismatch: expected $verify_size got $verify_actual_size"
  verify_actual_sha=$(sha256_file "$verify_tmp") || fail 69 "no SHA-256 implementation available"
  [ "$(printf '%s' "$verify_actual_sha" | tr 'A-F' 'a-f')" = "$(printf '%s' "$verify_sha" | tr 'A-F' 'a-f')" ] || fail 65 "checksum mismatch: $verify_name $verify_version"
  rm -f "$verify_meta" "$verify_tmp"; trap - 0 1 2 15
  log "verified: $verify_name $verify_version"
}

cmd_version(){
  if [ "$JSON" -eq 1 ]; then printf '{"name":"fw","version":"%s"}\n' "$(json_escape "$VERSION")"; else printf 'Fritz.Wulf fw %s\n' "$VERSION"; fi
}

cmd_repo(){
  if [ "$JSON" -eq 1 ]; then printf '{"base":"%s","index":"%s","packages":"%s"}\n' "$(json_escape "$FW_REPO_BASE")" "$(json_escape "$FW_INDEX_URL")" "$(json_escape "$FW_PACKAGES_URL")"; else printf '%s\n' "$FW_INDEX_URL"; fi
}
detect_model(){
  for path in /proc/device-tree/model /sys/firmware/devicetree/base/model; do
    if [ -r "$path" ]; then tr -d '\000' < "$path"; return; fi
  done
  if [ -r /proc/sys/urlader/environment ]; then
    value=$(sed -n 's/^ProductID[[:space:]]*//p' /proc/sys/urlader/environment | head -1)
    [ -n "$value" ] && { printf '%s' "$value"; return; }
  fi
  printf '%s' 'unknown'
}

detect_endianness(){
  if command -v od >/dev/null 2>&1; then
    value=$(printf '\001\000' | od -An -t u2 2>/dev/null | tr -d '[:space:]')
    [ "$value" = 1 ] && { printf '%s' little; return; }
    [ "$value" = 256 ] && { printf '%s' big; return; }
  fi
  printf '%s' unknown
}

cmd_device(){
  model=$(detect_model); arch=$(uname -m 2>/dev/null || printf unknown); kernel=$(uname -r 2>/dev/null || printf unknown); endian=$(detect_endianness)
  if [ "$JSON" -eq 1 ]; then
    printf '{"model":"%s","architecture":"%s","kernel":"%s","endianness":"%s"}\n' "$(json_escape "$model")" "$(json_escape "$arch")" "$(json_escape "$kernel")" "$(json_escape "$endian")"
  else
    printf 'model: %s\narchitecture: %s\nkernel: %s\nendianness: %s\n' "$model" "$arch" "$kernel" "$endian"
  fi
}

detect_signature_verifier(){
  if command -v usign >/dev/null 2>&1; then printf 'usign'
  elif command -v signify >/dev/null 2>&1; then printf 'signify'
  elif command -v signify-openbsd >/dev/null 2>&1; then printf 'signify'
  else printf 'missing'
  fi
}

cmd_doctor(){
  printf 'fw version: %s\n' "$VERSION"
  printf 'repository: %s\n' "$FW_INDEX_URL"
  printf 'fetcher: '; if command -v curl >/dev/null 2>&1; then printf 'curl\n'; elif command -v wget >/dev/null 2>&1; then printf 'wget\n'; else printf 'missing\n'; fi
  printf 'cache: %s\n' "$FW_CACHE_DIR"
  printf 'signature verifier: %s\n' "$(detect_signature_verifier)"
  printf 'signature enforcement: disabled\n'
}
cmd_help(){
  cat <<'EOF'
Fritz.Wulf package manager foundation
Usage: fw [--json] [--quiet] <command> [args]

Commands:
  version          show client version
  repo             show canonical repository index
  device           show safe local device facts
  doctor           inspect client prerequisites
  update           refresh index.json and Packages atomically
  list             list cached packages
  search <query>   search cached package metadata
  info <name>      show one cached package record
  verify <name> <version>  download and verify size + SHA-256

This release performs no package installation and no firmware flash.
EOF
}

command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
  version) cmd_version "$@" ;;
  repo) cmd_repo "$@" ;;
  device) cmd_device "$@" ;;
  doctor) cmd_doctor "$@" ;;
  update) cmd_update "$@" ;;
  list) cmd_list "$@" ;;
  search) cmd_search "$@" ;;
  info) cmd_info "$@" ;;
  verify) cmd_verify "$@" ;;
  help|-h|--help) cmd_help ;;
  *) fail 64 "unknown command: $command" ;;
esac